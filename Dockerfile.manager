ARG NODE_BASE=node:24.21.0-bookworm-slim
ARG NGINX_BASE=nginx:1.30.5-alpine
FROM ${NODE_BASE} AS build
ENV PNPM_HOME="/pnpm" PATH="/pnpm:$PATH"
RUN corepack enable && corepack prepare pnpm@11.25.0 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @argws/scout-manager build

FROM ${NGINX_BASE}
COPY --from=build /app/apps/manager/dist /usr/share/nginx/html
COPY apps/manager/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
