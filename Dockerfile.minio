ARG ALPINE_BASE=ghcr.io/wkarts/argws-scout-alpine:3.23
FROM ${ALPINE_BASE} AS downloader
RUN apk add --no-cache ca-certificates curl
ARG TARGETARCH
ARG MINIO_RELEASE=RELEASE.2025-09-07T16-13-09Z
ARG SHA_AMD64=7c5bd8512c6e966455b1d198209358b2d191c77a83ab377c4073281065fb855f
ARG SHA_ARM64=5c83cd2cf151717ba0243f73e1c7802ff36e272b67144bdd7f1f7d684fd6f03d
RUN set -eu; \
    case "${TARGETARCH}" in \
      amd64) checksum="${SHA_AMD64}" ;; \
      arm64) checksum="${SHA_ARM64}" ;; \
      *) echo "Unsupported MinIO architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fLsS --retry 4 --retry-delay 3 \
      "https://github.com/minio/minio/releases/download/${MINIO_RELEASE}/minio.linux-${TARGETARCH}.${MINIO_RELEASE}" \
      -o /minio; \
    printf '%s  %s\n' "${checksum}" "/minio" | sha256sum -c -; \
    chmod 0755 /minio

ARG ALPINE_BASE=ghcr.io/wkarts/argws-scout-alpine:3.23
FROM ${ALPINE_BASE}
RUN apk add --no-cache ca-certificates
COPY --from=downloader /minio /usr/local/bin/minio
WORKDIR /data
EXPOSE 9000 9001
ENTRYPOINT ["/usr/local/bin/minio"]
CMD ["server", "/data", "--console-address", ":9001"]
