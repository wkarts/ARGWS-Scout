NODE_ENV=development
SCOUT_ENV=develop
SCOUT_VERSION=0.7.0
SCOUT_PUBLIC_URL=http://localhost:5173
SCOUT_API_PORT=8080
SCOUT_MANAGER_PORT=48080
SCOUT_CORS_ORIGINS=http://localhost:5173,http://localhost:48080
SCOUT_COOKIE_SECURE=false
SCOUT_ALLOW_HTTP=true
SCOUT_TRUST_PROXY_HOPS=1
SCOUT_MFA_REQUIRED_FOR_OWNER=true

# SMTP global dedicado exclusivamente à recuperação de senha.
SCOUT_RECOVERY_SMTP_HOST=
SCOUT_RECOVERY_SMTP_PORT=587
SCOUT_RECOVERY_SMTP_SECURE=false
SCOUT_RECOVERY_SMTP_USERNAME=
SCOUT_RECOVERY_SMTP_PASSWORD=
SCOUT_RECOVERY_SMTP_FROM_EMAIL=
SCOUT_RECOVERY_SMTP_FROM_NAME=ARGWS Scout
SCOUT_BROWSER_CONCURRENCY=1

# Única conexão Connect|API da plataforma (somente a API lê esta chave).
# A URL precisa usar HTTPS; instâncias e tokens particulares são por espaço de trabalho.
SCOUT_CONNECT_API_URL=
SCOUT_CONNECT_API_TOKEN=
# Retenção de erros HTTP por espaço (7 a 365 dias).
SCOUT_DIAGNOSTIC_RETENTION_DAYS=30
LOG_LEVEL=info

# Gere novos valores para cada instalação; nunca use estes nomes como segredos reais.
SCOUT_JWT_SECRET=replace-with-at-least-32-random-bytes
SCOUT_ENCRYPTION_KEY_BASE64=REPLACE_WITH_BASE64_32_BYTE_KEY
SCOUT_BOOTSTRAP_TENANT_NAME=Minha organização
SCOUT_BOOTSTRAP_TENANT_SLUG=minha-organizacao
SCOUT_BOOTSTRAP_ADMIN_NAME=Administrador
SCOUT_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SCOUT_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password
POSTGRES_DB=scout
POSTGRES_USER=scout
POSTGRES_PASSWORD=replace-with-a-long-random-value
DATABASE_URL=postgresql://scout:replace-me@127.0.0.1:5432/scout?schema=public
REDIS_PASSWORD=replace-with-a-long-random-value
REDIS_URL=redis://:replace-with-a-long-random-value@127.0.0.1:6379/0
RABBITMQ_USER=scout
RABBITMQ_PASSWORD=replace-me
RABBITMQ_URL=amqp://scout:replace-me@127.0.0.1:5672
# MinIO opt-in: COMPOSE_PROFILES=minio, S3_ENDPOINT=http://minio:9000 (migração de objetos necessária)
S3_ENDPOINT=http://127.0.0.1:3900
ARGWS_SCOUT_MINIO_IMAGE=ghcr.io/wkarts/argws-scout-minio:RELEASE.2025-09-07T16-13-09Z
S3_ACCESS_KEY_ID=scout-artifacts
S3_SECRET_ACCESS_KEY=replace-me
S3_BUCKET=scout-artifacts
S3_REGION=us-east-1
# Requer 32 bytes aleatorios em hexadecimal (64 caracteres); prepare-env.py gera automaticamente.
# Preserve a chave depois da inicializacao, inclusive em atualizacoes.
GARAGE_RPC_SECRET=replace-with-64-hex-characters
GARAGE_ADMIN_TOKEN=replace-with-a-long-random-value
SCOUT_HTTP_TIMEOUT_MS=20000
SCOUT_HTTP_MAX_BYTES=2097152
SCOUT_BROWSER_TIMEOUT_MS=30000
# Ambientes Docker restritivos: desative o sandbox apenas no browser-worker isolado.
SCOUT_BROWSER_CHROMIUM_SANDBOX=false
SCOUT_JOB_MAX_ATTEMPTS=3
SCOUT_WEBHOOK_MAX_ATTEMPTS=8
SCOUT_WORKER_CONCURRENCY=2
SCOUT_SCHEDULER_POLL_MS=15000
SCOUT_DISPATCHER_POLL_MS=1000
SCOUT_WEBHOOK_USER_AGENT=ARGWS-Scout-Webhook/0.2

# Refinamento opcional de conteúdo (nunca envia mensagens automaticamente).
# Ative ambos e execute "docker compose --profile content up -d".
SCOUT_CONTENT_ENABLED=false
COMPOSE_PROFILES=
# Gere com: openssl rand -hex 32; manter igual no content-engine e content-worker.
SCOUT_CONTENT_ENGINE_KEY=
