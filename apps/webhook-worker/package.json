{
  "name": "@argws/scout-webhook-worker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/worker.ts",
    "start": "tsx src/worker.ts",
    "build": "tsup src/worker.ts --format esm --platform node --target node22 --out-dir dist --clean false",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@argws/scout-core": "workspace:*",
    "@argws/scout-shared": "workspace:*",
    "@prisma/client": "^6.16.2",
    "amqplib": "^0.10.9"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "tsup": "^8.5.0"
  }
}
