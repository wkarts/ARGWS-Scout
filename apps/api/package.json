{
  "name": "@argws/scout-api",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsup src/server.ts --format esm --platform node --target node22 --out-dir dist --clean false",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@argws/scout-core": "workspace:*",
    "@argws/scout-schemas": "workspace:*",
    "@argws/scout-shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.16.2",
    "amqplib": "^0.10.9",
    "argon2": "^0.44.0",
    "cron-parser": "^5.3.1",
    "fastify": "^5.5.0",
    "ioredis": "^5.6.1",
    "nodemailer": "^10.0.13",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.5",
    "tsup": "^8.5.0"
  }
}
