ARG NGINX_BASE=ghcr.io/wkarts/argws-scout-nginx:1.30.5-alpine
FROM ${NGINX_BASE}
COPY apps/docs/index.html /usr/share/nginx/html/index.html
COPY apps/docs/first-steps.html /usr/share/nginx/html/first-steps.html
COPY apps/docs/user-guide.html /usr/share/nginx/html/user-guide.html
COPY apps/docs/viewer.html /usr/share/nginx/html/viewer.html
COPY apps/docs/viewer.js /usr/share/nginx/html/viewer.js
COPY apps/docs/viewer-core.mjs /usr/share/nginx/html/viewer-core.mjs
COPY apps/docs/viewer.css /usr/share/nginx/html/viewer.css
COPY apps/docs/nginx.conf /etc/nginx/conf.d/default.conf
COPY VERSION /tmp/scout-version
RUN version="$(cat /tmp/scout-version)" && sed -i "s/__SCOUT_VERSION__/$version/g" /usr/share/nginx/html/index.html
COPY apps/manager/public/brand /usr/share/nginx/html/brand
COPY docs /usr/share/nginx/html/guides
COPY docs/openapi.yaml /usr/share/nginx/html/api/openapi.yaml
EXPOSE 80
