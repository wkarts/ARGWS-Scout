{
  "name": "@argws/scout-platform",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @argws/scout-api --filter @argws/scout-manager --filter @argws/scout-dispatcher --filter @argws/scout-worker --filter @argws/scout-browser-worker --filter @argws/scout-scheduler --filter @argws/scout-webhook-worker dev",
    "dev:api": "pnpm --filter @argws/scout-api dev",
    "dev:manager": "pnpm --filter @argws/scout-manager dev",
    "build": "pnpm db:generate && pnpm --recursive --if-present build",
    "typecheck": "pnpm db:generate && tsc --noEmit && pnpm --filter @argws/scout-manager typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "auth:diagnose": "tsx prisma/diagnose-auth.ts",
    "auth:recover-owner": "tsx prisma/recover-owner.ts",
    "storage:migrate": "pnpm --filter @argws/scout-shared exec tsx src/migrate-s3.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "dotenv": "^16.6.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "argon2": "^0.44.0",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5"
  }
}
