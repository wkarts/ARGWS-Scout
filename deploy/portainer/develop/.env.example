# Keep COMPOSE_PROJECT_NAME unchanged across updates to retain this stack's volumes and network.
# Portainer Docker Standalone: load this file as stack environment variables; Compose reads them from stack.env.
# SCOUT_IMAGE_OWNER e SCOUT_TAG selecionam as imagens Scout publicadas no GHCR.
SCOUT_ENV=develop
COMPOSE_PROJECT_NAME=argws-scout-portainer-develop
SCOUT_IMAGE_OWNER=wkarts
SCOUT_VERSION=0.5.4
SCOUT_TAG=develop
SCOUT_PUBLIC_URL=http://localhost:8083
SCOUT_MANAGER_PORT=8083
SCOUT_COOKIE_SECURE=false
SCOUT_ALLOW_HTTP=true
SCOUT_TRUST_PROXY_HOPS=1
SCOUT_MFA_REQUIRED_FOR_OWNER=true

# SMTP global dedicado exclusivamente à recuperação de senha.
SCOUT_RECOVERY_SMTP_HOST=
SCOUT_RECOVERY_SMTP_PORT=587
SCOUT_RECOVERY_SMTP_SECURE=false
SCOUT_RECOVERY_SMTP_USERNAME=
SCOUT_RECOVERY_SMTP_PASSWORD=
SCOUT_RECOVERY_SMTP_FROM_EMAIL=
SCOUT_RECOVERY_SMTP_FROM_NAME=ARGWS Scout
SCOUT_BROWSER_CONCURRENCY=1
# Hosts Docker sem user namespaces: browser-worker isolado, sem sandbox do Chromium.
# Se o host suportar namespaces e seccomp adequados, altere para true.
SCOUT_BROWSER_CHROMIUM_SANDBOX=false

ARGWS_SCOUT_POSTGRES_IMAGE=ghcr.io/wkarts/argws-scout-postgres:17.11-alpine3.23
ARGWS_SCOUT_REDIS_IMAGE=ghcr.io/wkarts/argws-scout-redis:7.4.9-alpine
ARGWS_SCOUT_RABBITMQ_IMAGE=ghcr.io/wkarts/argws-scout-rabbitmq:4.3.6-management-alpine
ARGWS_SCOUT_GARAGE_IMAGE=ghcr.io/wkarts/argws-scout-garage:v2.4.1
POSTGRES_DB=scout
POSTGRES_USER=scout
POSTGRES_PASSWORD=replace-me
REDIS_PASSWORD=replace-me
RABBITMQ_USER=scout
RABBITMQ_PASSWORD=replace-me
S3_ENDPOINT=http://garage:3900
S3_ACCESS_KEY_ID=scout-artifacts
S3_SECRET_ACCESS_KEY=replace-me
S3_BUCKET=scout-artifacts
S3_REGION=us-east-1
# GARAGE_RPC_SECRET deve ser hexadecimal de 64 caracteres: gere com openssl rand -hex 32.
# Preserve o valor original em atualizacoes; nao gere uma nova chave para uma instancia funcional.
GARAGE_RPC_SECRET=replace-me
GARAGE_ADMIN_TOKEN=replace-me
SCOUT_JWT_SECRET=replace-me
SCOUT_ENCRYPTION_KEY_BASE64=REPLACE_WITH_BASE64_32_BYTE_KEY
SCOUT_BOOTSTRAP_TENANT_NAME=Minha organização
SCOUT_BOOTSTRAP_TENANT_SLUG=minha-organizacao
SCOUT_BOOTSTRAP_ADMIN_NAME=Administrador
SCOUT_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SCOUT_BOOTSTRAP_ADMIN_PASSWORD=replace-me
SCOUT_HTTP_TIMEOUT_MS=20000
SCOUT_HTTP_MAX_BYTES=2097152
SCOUT_BROWSER_TIMEOUT_MS=30000
SCOUT_JOB_MAX_ATTEMPTS=3
SCOUT_WEBHOOK_MAX_ATTEMPTS=8
SCOUT_WORKER_CONCURRENCY=2
SCOUT_SCHEDULER_POLL_MS=15000
SCOUT_DISPATCHER_POLL_MS=1000
SCOUT_WEBHOOK_USER_AGENT=ARGWS-Scout-Webhook/0.2
