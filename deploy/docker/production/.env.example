# Change owner and tags in every image variable when deploying a fork.
SCOUT_ENV=production
SCOUT_VERSION=0.2.0-alpha.2
SCOUT_TAG=0.2.0-alpha.2
SCOUT_PUBLIC_URL=https://scout.example.com
SCOUT_MANAGER_PORT=8080
SCOUT_COOKIE_SECURE=false
SCOUT_ALLOW_HTTP=false
SCOUT_TRUST_PROXY_HOPS=1
SCOUT_MFA_REQUIRED_FOR_OWNER=true
SCOUT_BROWSER_CONCURRENCY=1

ARGWS_SCOUT_API_IMAGE=ghcr.io/wkarts/argws-scout-api:0.2.0-alpha.2
ARGWS_SCOUT_MIGRATION_IMAGE=ghcr.io/wkarts/argws-scout-migrate:0.2.0-alpha.2
ARGWS_SCOUT_DISPATCHER_IMAGE=ghcr.io/wkarts/argws-scout-dispatcher:0.2.0-alpha.2
ARGWS_SCOUT_WORKER_IMAGE=ghcr.io/wkarts/argws-scout-worker:0.2.0-alpha.2
ARGWS_SCOUT_SCHEDULER_IMAGE=ghcr.io/wkarts/argws-scout-scheduler:0.2.0-alpha.2
ARGWS_SCOUT_WEBHOOK_WORKER_IMAGE=ghcr.io/wkarts/argws-scout-webhook-worker:0.2.0-alpha.2
ARGWS_SCOUT_MANAGER_IMAGE=ghcr.io/wkarts/argws-scout-manager:0.2.0-alpha.2
ARGWS_SCOUT_DOCS_IMAGE=ghcr.io/wkarts/argws-scout-docs:0.2.0-alpha.2
ARGWS_SCOUT_BROWSER_WORKER_IMAGE=ghcr.io/wkarts/argws-scout-browser-worker:0.2.0-alpha.2
ARGWS_SCOUT_POSTGRES_IMAGE=ghcr.io/wkarts/argws-scout-postgres:17.11-alpine3.23
ARGWS_SCOUT_REDIS_IMAGE=ghcr.io/wkarts/argws-scout-redis:7.4.9-alpine
ARGWS_SCOUT_RABBITMQ_IMAGE=ghcr.io/wkarts/argws-scout-rabbitmq:4.3.6-management-alpine
ARGWS_SCOUT_GARAGE_IMAGE=ghcr.io/wkarts/argws-scout-garage:v2.4.1
ARGWS_SCOUT_GARAGE_INIT_IMAGE=ghcr.io/wkarts/argws-scout-garage-init:0.2.0-alpha.2

POSTGRES_DB=scout
POSTGRES_USER=scout
POSTGRES_PASSWORD=replace-me
REDIS_PASSWORD=replace-me
RABBITMQ_USER=scout
RABBITMQ_PASSWORD=replace-me
S3_ENDPOINT=http://garage:3900
S3_ACCESS_KEY_ID=scout-artifacts
S3_SECRET_ACCESS_KEY=replace-me
S3_BUCKET=scout-artifacts
S3_REGION=us-east-1
GARAGE_RPC_SECRET=replace-me
GARAGE_ADMIN_TOKEN=replace-me
SCOUT_JWT_SECRET=replace-me
SCOUT_ENCRYPTION_KEY_BASE64=replace-me
SCOUT_BOOTSTRAP_TENANT_NAME=Minha organização
SCOUT_BOOTSTRAP_TENANT_SLUG=minha-organizacao
SCOUT_BOOTSTRAP_ADMIN_NAME=Administrador
SCOUT_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SCOUT_BOOTSTRAP_ADMIN_PASSWORD=replace-me

SCOUT_HTTP_TIMEOUT_MS=20000
SCOUT_HTTP_MAX_BYTES=2097152
SCOUT_BROWSER_TIMEOUT_MS=30000
SCOUT_JOB_MAX_ATTEMPTS=3
SCOUT_WEBHOOK_MAX_ATTEMPTS=8
SCOUT_WORKER_CONCURRENCY=2
SCOUT_SCHEDULER_POLL_MS=15000
SCOUT_DISPATCHER_POLL_MS=1000
SCOUT_WEBHOOK_USER_AGENT=ARGWS-Scout-Webhook/0.2
